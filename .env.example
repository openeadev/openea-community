# OpenEA Community
# Copy this file to .env and replace SECRET_KEY before production use.

APP_NAME=OpenEA Community
PAGE_TITLE=OpenEA Community
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
SECRET_KEY=replace-this-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=28800
TRUSTED_PROXY_COUNT=0

# Optional Google reCAPTCHA v2 checkbox protection for browser login.
# Leave both values blank for normal/offline installations.
#
# Local development:
#   Use a separate Challenge (v2) / checkbox key restricted to `localhost`.
#   Do not include the scheme or port in Google's allowed-domain entry.
#
# Production/demo:
#   Use a different Challenge (v2) / checkbox key restricted to the deployed
#   hostname (for example, demo.openea.dev). Keep production key material in
#   the hosting platform's environment settings rather than committing it.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

OPENEA_PORT=8000
OPENEA_IMAGE=openea-community:1.5.2
POSTGRES_DB=openea
POSTGRES_USER=openea
POSTGRES_PASSWORD=openea
